# 本地联调用：复制为 .env 后填真实值。
# .env 已在 .gitignore 中，不会入库；本文件（.env.example）会入库，别往里写真值。

# GitHub fine-grained PAT：限定 wjn18/portfolio-site 单仓库，Contents: read + write
GITHUB_TOKEN=

GITHUB_REPO=wjn18/portfolio-site
GITHUB_BRANCH=main

# 管理口令的 sha256。生成：
# node -e "console.log(require('crypto').createHash('sha256').update('你的口令').digest('hex'))"
ADMIN_PASSWORD_SHA256=

# 随机长字符串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 可选：配了后台概览页才显示部署状态
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
